# Raphael (Redmi K20 Pro) phone tweaks on top of qcom-phone.config
CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="board/qualcomm/raphael-phone.env"

# Keep the Android bootloader splash in the framebuffer (qcom_defconfig sets
# NO_FB_CLEAR). Do not draw the U-Boot logo on top.
# CONFIG_VIDEO_LOGO is not set

# Skip "In: / Out: / Err:" on every boot.
CONFIG_SYS_CONSOLE_INFO_QUIET=y

# rEFInd shutdown uses EfiResetShutdown -> do_poweroff().
CONFIG_CMD_POWEROFF=y
CONFIG_SYSRESET_CMD_POWEROFF=y

# Ensure EFI block I/O buffers stay below 4GB for UFS DMA compatibility.
# 128GB UFS devices on SM8150 can fail with OCS_INVALID_CMD_TABLE_ATTR
# when rEFInd allocates initrd/dtb buffers above the 32-bit boundary.
CONFIG_EFI_LOADER_BOUNCE_BUFFER=y
CONFIG_BOUNCE_BUFFER=y
