bootdelay=0
bootretry=1
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

fastboot=fastboot -l $fastboot_addr_r usb 0

preboot=scsi scan; usb start

serial_gadget=setenv stdin serial,button-kbd,usbacm; setenv stdout serial,vidconsole,usbacm; setenv stderr serial,vidconsole,usbacm; setenv bootretry -1; echo Enabled U-Boot console serial gadget

# Same as raphael-phone.env: load rEFInd from Android cust (FAT), not GPT ESP.
boot_efi=part number scsi 0 cust efi_part; if fatload scsi 0:${efi_part} ${loadaddr} EFI/BOOT/BOOTAA64.EFI || fatload scsi 0:${efi_part} ${loadaddr} boot/BOOTAA64.EFI; then bootefi ${loadaddr}; else echo "ERROR: no EFI payload on cust (tried EFI/BOOT and boot/)"; bootefi bootmgr; fi

bootcmd=run boot_efi; pause; run menucmd

menucmd=setenv bootcmd run menucmd; bootmenu -1

bootmenu_0=Boot=run boot_efi; pause
bootmenu_1=Enable serial console gadget=run serial_gadget
bootmenu_2=Enable USB mass storage=echo "Press any key to exit UMS mode"; ums 0 scsi 0,4
bootmenu_3=Enable fastboot mode=run fastboot
bootmenu_4=Drop to shell=setenv bootretry -1
bootmenu_5=Reset device=reset
bootmenu_6=Shutdown device=poweroff
bootmenu_7=Dump clocks=clk dump; pause
bootmenu_8=Dump environment=printenv; pause
bootmenu_9=Board info=bdinfo; pause
bootmenu_10=Dump bootargs=fdt print /chosen bootargs; pause

button_cmd_0_name=Volume Down
button_cmd_0=run menucmd
